<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GestionITM.AppMovil.Views.CursosPage"
             BackgroundColor="#071427">

    <ContentPage.Content>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Cursos Disponibles" FontSize="26" FontAttributes="Bold" TextColor="#E6F0FF" HorizontalOptions="Center" />
            <Label Text="Explora y matricúlate" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Cursos}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="12" HasShadow="True" Padding="10" BackgroundColor="#0B2230" Margin="6">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" TextColor="#E6F0FF" FontSize="16" />
                                <Label Text="{Binding Profesor}" FontSize="12" TextColor="#94A3B8" />
                                <HorizontalStackLayout HorizontalOptions="End">
                                    <Button Text="Ver" FontSize="12" CornerRadius="8" BackgroundColor="#2563EB" TextColor="White" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="30">
                        <Label Text="No hay cursos para mostrar" TextColor="#94A3B8" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
