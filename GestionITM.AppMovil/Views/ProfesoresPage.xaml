<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestionITM.AppMovil.ViewModels"
             xmlns:models="clr-namespace:GestionITM.AppMovil.Models"
             x:Class="GestionITM.AppMovil.Views.ProfesoresPage"
             x:DataType="viewmodels:ProfesoresViewModel"
             Title="{Binding TituloPantalla}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
<ActivityIndicator Grid.Row="0" 
    IsRunning="{Binding EstaCargando}"
    IsVisible="{Binding EstaCargando}"
    Color="Blue" />
    
    <CollectionView Grid.Row="1" ItemsSource="{Binding ListaProfesores}">

        <CollectionView.EmptyView>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                <Label Text="👨‍🏫" FontSize="50" HorizontalOptions="Center" />
                <Label Text="Aún no hay profesores registrados." TextColor="Gray" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                <Label Text="Toca el botón inferior para buscar en el servidor." TextColor="LightGray" FontSize="14" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:ProfesorModel">
                        <Frame Margin="0,5" Padding="10" BorderColor="LightGray">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Especialidad}" FontSize="14" TextColor="Gray" />
                            </VerticalStackLayout>
                            </Frame>
                            </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
                
                <Button Grid.Row="2"
                                    Text="Descargar Profesores"
                                    Command="{Binding CargarProfesoresCommand}"
                                    Margin="0,20,0,0" />
    </Grid>
                </ContentPage>
                        